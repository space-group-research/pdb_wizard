! CP2K cell optimization — generated by pdb_wizard from cp2k_cell_opt.inp
! Placeholders are triple-brace tokens. The per-element &KIND block
! (basis + GTH pseudopotential) is built by the generator and slotted in
! as a single multi-line value.

&GLOBAL
  PROJECT {{{project}}}
  RUN_TYPE CELL_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &SUBSYS
    &CELL
      A   {{{cell_a}}} 0.000000 0.000000
      B   0.000000 {{{cell_b}}} 0.000000
      C   0.000000 0.000000 {{{cell_c}}}
      ALPHA_BETA_GAMMA {{{cell_alpha}}} {{{cell_beta}}} {{{cell_gamma}}}
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME {{{coords_file}}}
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
{{{kind_blocks}}}  &END SUBSYS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF {{{cutoff_ry}}}
      REL_CUTOFF {{{rel_cutoff_ry}}}
    &END MGRID
    &SCF
      EPS_SCF {{{eps_scf}}}
      MAX_SCF {{{max_scf}}}
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF {{{eps_scf}}}
        MAX_SCF 20
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL {{{xc_functional}}}
      &END
    &END XC
  &END DFT
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    OPTIMIZER LBFGS
    KEEP_ANGLES T
    MAX_ITER {{{n_opt_steps}}}
    TYPE DIRECT_CELL_OPT
  &END CELL_OPT
  &PRINT
    &TRAJECTORY
      &EACH
        CELL_OPT 1
      &END
    &END
    &CELL
      &EACH
        CELL_OPT 1
      &END
    &END
  &END
&END MOTION
