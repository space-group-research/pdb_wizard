! MPMC isotherm input — generated by pdb_wizard from template mpmc_uvt.inp
! Placeholders are written as triple-brace tokens; the Input Generator
! UI re-renders this file with the values you choose.

job_name              {{{job_name}}}

ensemble              {{{ensemble}}}

abcbasis              {{{cell_a}}} {{{cell_b}}} {{{cell_c}}} {{{cell_alpha}}} {{{cell_beta}}} {{{cell_gamma}}}

temperature           {{{temperature}}}
pressure              {{{pressure}}}

numsteps              {{{numsteps}}}
corrtime              {{{corrtime}}}
insert_probability    {{{insert_probability}}}
move_factor           {{{move_factor}}}
rot_factor            {{{rot_factor}}}

pqr_input             {{{pqr_input}}}
pqr_output            output.pqr
pqr_restart           restart.pqr
traj_output           trajectory.pqr
energy_output         energy.dat

! No insert_input: the sorbate is already embedded in pqr_input as a movable
! molecule, which MPMC clones for insertions. Pointing insert_input at a
! separate pool triggers a double-free in MPMC's cleanup (crash on exit).

rd_lrc                on
wrapall               on

{{{model_keywords}}}

pop_histogram         on
pop_histogram_output  histogram.dat
