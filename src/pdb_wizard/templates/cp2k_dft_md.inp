! CP2K Born-Oppenheimer NVT MD — generated by pdb_wizard from cp2k_dft_md.inp
! Placeholders are triple-brace tokens. The per-element &KIND block
! (basis + GTH pseudopotential) is built by the generator and slotted in
! as a single multi-line value.

&GLOBAL
  PROJECT {{{project}}}
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP
  STRESS_TENSOR ANALYTICAL
  &SUBSYS
    &CELL
      A   {{{cell_vec_a}}}
      B   {{{cell_vec_b}}}
      C   {{{cell_vec_c}}}
      PERIODIC XYZ
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME {{{coords_file}}}
      COORD_FILE_FORMAT XYZ
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
{{{kind_blocks}}}  &END SUBSYS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF {{{cutoff_ry}}}
      REL_CUTOFF {{{rel_cutoff_ry}}}
    &END MGRID
    &SCF
      EPS_SCF {{{eps_scf}}}
      MAX_SCF {{{max_scf}}}
      &OT
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
      &END OT
      &OUTER_SCF
        EPS_SCF {{{eps_scf}}}
        MAX_SCF 20
      &END
    &END SCF
    &XC
      &XC_FUNCTIONAL {{{xc_functional}}}
      &END
    &END XC
  &END DFT
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NVT
    TIMESTEP {{{timestep_fs}}}
    STEPS {{{n_md_steps}}}
    TEMPERATURE {{{temperature}}}
    &THERMOSTAT
      TYPE NOSE
      &NOSE
        TIMECON 50
      &END
    &END
  &END MD
  &PRINT
    &TRAJECTORY
      FILENAME =trajectory.xyz
      FORMAT XYZ
      &EACH
        MD {{{md_traj_interval}}}
      &END
    &END
    &VELOCITIES OFF
    &END
    &RESTART
      FILENAME =restart
      &EACH
        MD 100
      &END
    &END
  &END
&END MOTION
